---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import HeroStage from '../components/sections/HeroStage.astro';
import MotifStrips from '../components/sections/MotifStrips.astro';
import CollectionRail from '../components/sections/CollectionRail.astro';
import CategoryIndex from '../components/sections/CategoryIndex.astro';
import TheCraft from '../components/sections/TheCraft.astro';
import Sustain from '../components/sections/Sustain.astro';
import BestBento from '../components/sections/BestBento.astro';
import ReviewRows from '../components/sections/ReviewRows.astro';
import LookSwitch from '../components/sections/LookSwitch.astro';
---

<BaseLayout>
  <Navbar />
  <main id="main">
    <HeroStage />
    <MotifStrips />
    <CollectionRail />
    <CategoryIndex />
    <TheCraft />
    <Sustain />
    <BestBento />
    <ReviewRows />
    <LookSwitch />
  </main>
  <Footer />
</BaseLayout>
