---
import { u } from '../../lib/url';
const left = [
  { label: 'Women', href: '#' },
  { label: 'Men', href: '#' },
  { label: 'Collection', href: '#new-collection' },
  { label: 'Stories', href: '#motif-stories' },
  { label: 'Sale', href: '#', sale: true },
];
---

<header class="site">
  <div class="banner">
    <div class="container">
      <span>Free shipping di atas Rp 750.000</span>
      <span>30-day return</span>
      <span>100% Made in Java</span>
    </div>
  </div>
  <nav class="bar" aria-label="Utama">
    <div class="container">
      <ul>
        {left.map((l) => (
          <li><a href={l.href} class={l.sale ? 'sale' : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <a href={u('/')} class="wordmark" aria-label="Wastraloka, beranda">Wastraloka</a>
      <ul>
        <li><button type="button" aria-label="Cari produk">Cari</button></li>
        <li><button type="button" aria-label="Akun saya">Akun</button></li>
        <li><button type="button" aria-label="Keranjang belanja">Keranjang 0</button></li>
        <li><a href="#new-collection" class="btn btn--sm">Shop Now</a></li>
      </ul>
    </div>
  </nav>
</header>
