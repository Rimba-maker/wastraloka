---
const groups = [
  { title: 'Bantuan', links: ['Cara Perawatan Batik', 'Panduan Ukuran', 'Pengiriman & Return', 'FAQ', 'Hubungi Kami'] },
  { title: 'Eksplorasi', links: ['Women', 'Men', 'Wedding Series', 'Lookbook', 'Motif Stories'] },
  { title: 'Tentang Kami', links: ['Our Story', 'The Craft', 'Pengrajin Mitra', 'Sustainability', 'Press & Media'] },
];
const socials = [
  { label: 'Instagram', href: 'https://instagram.com/wastraloka' },
  { label: 'TikTok', href: '#' },
  { label: 'Pinterest', href: '#' },
  { label: 'YouTube', href: '#' },
];
const press = ['Vogue Indonesia', "Harper's Bazaar", 'Tempo Magazine', 'The Jakarta Post', 'Bridestory'];
const payments = ['BCA', 'Mandiri', 'OVO', 'GoPay', 'ShopeePay', 'VISA'];
---

<footer class="foot">
  <div class="container">
    <p class="press-title" id="press">Diliput oleh</p>
    <ul class="press" aria-labelledby="press">
      {press.map((n) => <li>{n}</li>)}
    </ul>

    <div class="foot__top">
      <div class="foot__brand">
        <span class="wordmark">Wastraloka</span>
        <p>Crafted in Java, worn worldwide.</p>
      </div>

      <div class="foot__form">
        <h2>Bergabung dengan Keluarga Wastraloka</h2>
        <p>
          Dapatkan akses early ke new collection, story di balik motif, dan
          diskon eksklusif 10% untuk first order.
        </p>
        <form class="signup" data-endpoint="" novalidate>
          <label for="email">Alamat email</label>
          <div class="signup__row">
            <input id="email" name="email" type="email" autocomplete="email" required />
            <button class="btn" type="submit">Gabung</button>
          </div>
          <p class="signup__help" id="email-help" aria-live="polite"></p>
        </form>
      </div>

      <div class="foot__links">
        {groups.map((g) => (
          <div>
            <h3>{g.title}</h3>
            <ul>
              {g.links.map((l) => <li><a href="#">{l}</a></li>)}
            </ul>
          </div>
        ))}
        <div>
          <h3>Ikuti kami</h3>
          <ul>
            {socials.map((s) => (
              <li><a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <div class="foot__legal">
      <p>© 2026 Wastraloka. Pembayaran lewat {payments.join(', ')}.</p>
      <p data-credits>Foto: Pexels.</p>
    </div>
  </div>
</footer>
