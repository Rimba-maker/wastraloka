---
import { u } from '../../lib/url';
const steps = [
  { title: 'Menggambar Pola', desc: 'Desainer kami berkolaborasi langsung dengan pengrajin merancang motif, memadukan filosofi tradisional dengan estetika kontemporer.', img: '/img/craft-1.jpg', alt: 'Pengrajin menggambar pola batik di atas kain putih' },
  { title: 'Membatik (Tulis / Cap)', desc: 'Batik tulis untuk koleksi premium, setiap titik canting dikerjakan tangan. Batik cap untuk produksi terbatas dengan presisi motif terjaga.', img: '/img/craft-2.jpg', alt: 'Tangan memegang canting berisi malam di atas kain' },
  { title: 'Pewarnaan Natural', desc: 'Indigo untuk biru yang dalam, mengkudu untuk merah hangat, soga untuk coklat elegan, pewarna alami yang ramah bumi.', img: '/img/craft-3.jpg', alt: 'Kain batik berwarna digantung di luar ruangan' },
  { title: 'Menjahit & Finishing', desc: 'Cutting modern dikerjakan di Solo, draping flattering untuk berbagai bentuk tubuh, dengan finishing detail yang terasa di setiap jahitan.', img: '/img/craft-4.jpg', alt: 'Kain batik parang yang sudah jadi' },
];
---

<section class="section section--tall" id="the-craft" aria-labelledby="craft-title">
  <div class="container">
    <div class="section__head">
      <div>
        <h2 id="craft-title">Kerajinan yang tidak bisa diburu-buru</h2>
        <p class="lead">Setiap helai Wastraloka melewati 14 sampai 21 tahap, dari menggambar pola hingga finishing. Kami bekerja sama dengan 35+ pengrajin di Pekalongan, Solo, Cirebon, dan Madura.</p>
      </div>
    </div>

    <div class="figures">
      <div><b>35+</b><span>Pengrajin Mitra</span></div>
      <div><b>21</b><span>Tahap Produksi</span></div>
      <div><b>100%</b><span>Made in Java</span></div>
    </div>

    <div class="pinned" data-pinned>
      <div class="pinned__stack mat" data-step="1">
        <div class="photo" data-slot="craft" data-alt="Proses membatik di Jawa">
          {steps.map((s) => (
            <img src={u(s.img)} alt={s.alt} width="1100" height="1375" loading="lazy" decoding="async" />
          ))}
        </div>
      </div>
      <ol class="steps">
        {steps.map((s) => (
          <li>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
