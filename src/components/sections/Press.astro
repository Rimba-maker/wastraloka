---
const pressNames = [
  'Vogue Indonesia',
  "Harper's Bazaar",
  'Tempo Magazine',
  'The Jakarta Post',
  'Bridestory',
];
---

<section class="press">
  <div class="container">
    <p class="press-label">Diliput Oleh</p>
    <ul class="press-logos" role="list">
      {pressNames.map((name) => (
        <li>
          <span class="press-name">{name}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .press {
    padding-block: 3rem;
    border-top: 1px solid var(--color-hairline-soft);
    border-bottom: 1px solid var(--color-hairline-soft);
    background-color: var(--color-canvas);
  }

  .press-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .press-logos {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3.25rem;
    flex-wrap: wrap;
    list-style: none;
  }

  .press-name {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--color-muted-soft);
    letter-spacing: 0.02em;
    transition: color 0.2s ease;
    cursor: default;
  }

  .press-name:hover {
    color: var(--color-ink);
  }
</style>
